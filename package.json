{
  "name": "video-generator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @video-generator/db --",
    "db:studio": "turbo run db:studio -F @video-generator/db --",
    "db:generate": "turbo run db:generate -F @video-generator/db --",
    "db:migrate": "turbo run db:migrate -F @video-generator/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && pnpm run auth:generate"
  },
  "dependencies": {
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@video-generator/config": "workspace:*",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
