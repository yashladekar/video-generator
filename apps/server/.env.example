NODE_ENV=development
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://video_generator:video_generator@localhost:5433/video_generator?schema=public
APP_ENCRYPTION_KEY=replace-with-a-random-32-plus-character-secret
MEDIA_SIGNING_SECRET=replace-with-a-random-32-plus-character-secret
REDIS_URL=redis://localhost:6380
MEDIA_ROOT=./storage
PUBLIC_API_URL=http://localhost:3000

# Optional local services
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# PIPER_BIN=
# PIPER_MODEL=
# FFMPEG_PATH=
# FFPROBE_PATH=

# Optional hosted providers (or enter them in Settings -> Providers)
# PEXELS_API_KEY=
# FAL_KEY=
# WAVESPEED_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ELEVENLABS_API_KEY=
# TAVILY_API_KEY=

# Optional YouTube OAuth app
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback

# Optional S3-compatible storage
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Limits
MEDIA_RETENTION_DAYS=30
MAX_UPLOAD_MB=200
WORKER_CONCURRENCY=1
USD_TO_INR_RATE=88
