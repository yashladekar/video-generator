{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "concurrently -k -n api,worker -c blue,magenta \"tsx watch src/index.ts\" \"tsx watch src/worker.ts\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/index.mjs",
    "start:worker": "node dist/worker.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "@video-generator/api": "workspace:*",
    "@video-generator/auth": "workspace:*",
    "@video-generator/db": "workspace:*",
    "better-auth": "catalog:",
    "bullmq": "^6.3.15",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "file-type": "^22.2.0",
    "ioredis": "^6.0.0",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@video-generator/config": "workspace:*",
    "concurrently": "^10.0.6",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
}
